# Copy this file to .env in this folder and fill in the values you need.
# Only FABRIC_WORKSPACE_ID is always required; everything else depends on what you run.

# The Fabric workspace a run builds in and asserts against. Always required — an identity
# can see many workspaces and only one of them is the subject of the run.
FABRIC_WORKSPACE_ID=3897a34d-a240-4af8-a23e-86a5eeec7f02

# Set this where there is no browser to open (a container, an SSH session): user sign-in
# prints a code to enter on another device instead. Use the URL the sign-in PRINTS and no
# other — a guessed device-login URL answers "You don't have access to this".
# FABRIC_AUTH_DEVICE_CODE=1

# Where the user-mode sign-in is cached. Empty = ~/.fabric_kb/msal_cache.json, which is
# per-HOME — so a sign-in done in your terminal is invisible to an agent whose shell runs in
# a container, WSL or a sandbox with a HOME of its own, and every command it runs after that
# reports "not signed in" for a sign-in that plainly worked.
#
# SET THIS, exactly as written below, if your agent runs commands anywhere other than the
# terminal you sign in from. The path is relative to this repo — the one directory both
# environments can reach, each by its own route — so one line serves both. It is gitignored.
# `python code/core/auth.py --status` prints where any given shell is looking.
FABRIC_TOKEN_CACHE=.fabric_kb/msal_cache.json
