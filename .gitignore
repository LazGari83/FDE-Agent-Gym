.ruff_cache/

# PyPI configuration file
.pypirc

# Cursor  
#  Cursor is an AI-powered code editor.`.cursorignore` specifies files/directories to 
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore
# Node/JS build trees. The azure-app gym's application tasks run `npm install` inside the
# task folder (app-source resolves paths against the spec's own directory, so the rep's app
# has to live there). Ignored repo-wide rather than per task folder, so no task can
# accidentally commit a vendored dependency tree.
node_modules/
1_agent-gym/**/app/
1_agent-gym/**/build/
1_agent-gym/**/design/
