# preflight_probe.py cached passes (6h TTL) — facts about your tenant, not the repo's.
# Matched anywhere, not just at the sanctioned path: an agent runtime that resolves the
# repo root differently drops the cache beside its own config instead, and a tracked copy
# ships a stranger's workspace and capacity ids to everyone who clones.
**/.preflight-cache.json

# MSAL token cache. It normally lives at ~/.fabric_kb/msal_cache.json — outside any clone —
# but it holds REFRESH tokens, so it is matched here too in case the path ever moves or a
# container sets HOME to the working tree.
**/msal_cache.json
**/.fabric_kb/

# update-framework's undo. Every file an update modified or deleted is copied here before it
# writes, so `--restore` works for a member who does not use git. Not committed: it is a
# duplicate of files already in history, and it would double the repo on every release.
.framework-backup/

# Transient git worktrees for background subagents (one per parallel gym circuit).
# These are checkouts of this repo, not content: committing them would nest the working
# tree inside itself, and they are removed when the agent finishes.
.claude/worktrees/

# Windows junk: a cmd-style variable left unexpanded by a POSIX shell creates a literal
# %SystemDrive% directory (full of Explorer shell caches) wherever the command ran.
%SystemDrive%/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

.obsidian/
# C extensions
*.so

